--!strict
--[[
	Lobby: Everkeep's ground floor at night (GDD "The lobby", D-112, D-259, art/lobby/README.md).
	You load in just inside the glass front door, facing six freight cars along the back wall 150
	studs away, the counter and its shelves to your left, the cart rack to your right of the door,
	and six storage units down each side wall between you and the cars, one a player (D-260).

	The art is one imported model (art/lobby/out/Lobby.fbx), kept in the place at
	ReplicatedStorage.Props.Lobby (D-009) and made a template once in Edit by `Lobby.prepare`.
	`Lobby.lay` copies it into the world with what the game adds: Everkeep's paint, the numbers and
	signs, the boxes on the shelves, the hall lights over the cars, the room's warm fills, in each
	unit's gap a home's front (Home: the climb's M door rig in an oak-cased doorway, its door
	working as on a climb, a light switch inside) with its starter set, the plants, benches and
	planters round the floor (Specs.Dressing), and, in each bay, the climb's own car with its gate
	folded open, marked a lobby car (Boarding): the way into a climb (LobbyCars, L-08e1b1).

	Frame: the lobby's pivot is on the floor at the middle of the bay wall's face, its LookVector
	from the cars toward the front door (Specs, generated by art/lobby/build.py).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Arranged = require(script.Parent.Home.Arranged)
local Boarding = require(script.Boarding)
local Boxes = require(script.Parent.Boxes)
local Cart = require(script.Parent.Cart)
local CorridorKit = require(script.Parent.CorridorKit)
local Elevator = require(script.Parent.Elevator)
local Gate = require(script.Parent.Elevator.Gate)
local HallLight = require(script.Parent.HallLight)
local Home = require(script.Parent.Home)
local Specs = require(script.Specs)
local StorageUnit = require(script.Parent.StorageUnit)
local UnitLight = require(script.Parent.UnitLight)

local Lobby = {}
Lobby.Specs = Specs

-- Where the front office is laid on every server, far from the test hall (around the origin, out
-- to 700 along X) and the climb's floors (600 down -Z), so neither streams the other in.
Lobby.Origin = CFrame.new(0, 0, 600)
-- Where a climb the lobby's cars start lays its floor 1, each floor above further on along -Z
-- (Climbs): far from the lobby, the test hall and the test hall's own climb (0, 0, -600), so none
-- streams another in, and a floor 1 laid ahead never overlaps the test hall's floor in Studio.
Lobby.ClimbOrigin = CFrame.new(-1600, 0, -600)

-- Everkeep's colours. The bay wall's painted panels (Facade) keep the climb's teal, so the cars'
-- lit cream insides stand out at a glance; the counter's front is the units' cream. The striped
-- zones before the cars are the climb's sill yellow, worn into concrete. Past the cars the floor is
-- a home (D-263, D-264): the sheets' own paints, each the Color under a plaster map's clear alpha.
Lobby.Paint = {
	Walls = Color3.fromRGB(47, 100, 102),
	Sage = Color3.fromHex("#93A68F"), -- the side walls below the rail
	Cream = Color3.fromHex("#E6DDCC"), -- above the rail
	Ceiling = Color3.fromHex("#F5F2EB"), -- a soft white between the beams
	UnitWalls = Color3.fromHex("#E8DFCF"), -- the units' insides: warm white
	UnitTops = Color3.fromHex("#F1EBDF"),
	Lamps = Color3.fromRGB(255, 236, 208), -- the round ceiling lamps' glow: warm, never blue
	Counter = Color3.fromRGB(207, 202, 192),
	Stripes = Color3.fromRGB(196, 150, 34),
	Glass = Color3.fromRGB(70, 84, 88),
	Plate = Color3.fromRGB(38, 40, 42), -- under the plates' texture, if it fails to load
}

-- The units' roll-up doors: the climb's oxblood, warm against the teal walls either side, so the
-- twelve doors read as doors from the spawn, not as more wall (their facades wear Paint.Walls).
Lobby.UnitDoor = StorageUnit.UnitKit.Colours.Door.Oxblood
-- The parts of the climb's M unit each front leaves out: the lobby's mesh stands the unit's walls,
-- floor and top behind the gap (D-261), so only the facade, frame and door are the M's.
Lobby.Dropped = { "WallLeft", "WallRight", "WallBack", "Floor", "Top" }

-- The writing on the signs: Builder Sans Bold, off-white, a little self-lit so a bay's number
-- reads from the door on a phone even where the hall lights don't reach it.
Lobby.Ink = Color3.fromRGB(236, 231, 216)
Lobby.InkLight = 0.35 -- the SurfaceGuis' LightInfluence: 0 glows, 1 is lit only by the room
Lobby.Words = { Name = "EVERKEEP SELF STORAGE", Carts = "CARTS" } :: { [string]: string }

-- The room's light. The hall lights hang only over the cars (the climb's edge stays there) and
-- glow (Neon) but throw no light of their own: the room is lit by wide fills that cast no shadow, a
-- pair in each of three rows down its 156 studs, and the cars by their own lamps, so the six cars
-- are the brightest things ahead and the units' lit doorways the brightest either side. Real
-- lights: these six, the six lamps, the porch light, each home's ceiling and floor lamp.
-- The fills carry HallLight's tag, so shut in your home with its light off it goes dark
-- (BehindDoors keeps the room's light out on your screen, as a climb unit keeps the hall's).
Lobby.Fill = {
	Colour = Color3.fromRGB(255, 232, 206), -- a warm white: evening in a home, not a warehouse
	Brightness = 0.55,
	Range = 60, -- a PointLight's most: each row's reach overlaps the next's
	Height = 10, -- under the joists, over the cars' heads
	Across = 27, -- each one this far either side of the room's middle, over the middle row
	-- each row this far from the bay wall: the first over the cars' zones, the last 20 studs ahead
	-- of the spawn, so you load in to a lit floor running away to the cars, not a black hall
	Deep = { 26, 78, 130 },
}

-- The porch light outside over the front door: a sodium lamp's pool on the concrete, so the
-- glass shows the night outside and reads as the way out. A spot pointing down and out, shadowed so
-- the wall keeps it out of the room.
Lobby.Porch = {
	Colour = Color3.fromRGB(255, 172, 96),
	Brightness = 2,
	Range = 20,
	Angle = 100,
	At = Vector3.new(0, 10.5, -49.5), -- in the lobby's frame: over the door, just outside the glass
	Aim = Vector3.new(0, -1, -0.6), -- down, and out across the apron
}

-- The carts in the rack by the door, slot by slot (Specs.CartSlots): each a degree or two off
-- square and its front casters turned every which way, as carts left standing are, so the rack
-- reads as used, not placed. Turn: degrees about Y; Casters: the left and right front casters'
-- turns about their kingpins (0 trails behind, as when pushed nose first).
Lobby.Parked = {
	{ Turn = -1.2, Casters = { 20, -35 } },
	{ Turn = 0.8, Casters = { 180, 160 } },
	{ Turn = 1.6, Casters = { -15, 90 } },
	{ Turn = -0.5, Casters = { 200, 25 } },
	{ Turn = 1.0, Casters = { -80, -100 } },
	{ Turn = -1.5, Casters = { 10, 170 } },
}

local function vec(v: { number }): Vector3
	return Vector3.new(v[1], v[2], v[3])
end

local function part(model: Instance, name: string): BasePart
	local found = model:FindFirstChild(name, true)
	assert(found and found:IsA("BasePart"), `Lobby: {model:GetFullName()} has no {name}`)
	return found
end

function Lobby.template(): Model?
	local props = ReplicatedStorage:FindFirstChild("Props")
	local found = if props then props:FindFirstChild("Lobby") else nil
	return if found and found:IsA("Model") then found else nil
end

-- Bay `i`'s car (1 to 6, left to right as you face them): where the elevator's threshold sits.
function Lobby.bay(pivot: CFrame, i: number): CFrame
	return pivot * CFrame.new(Specs.Bays[i], 0, 0)
end

-- Where you stand when you load in: just inside the door, facing the cars.
function Lobby.spawn(pivot: CFrame): CFrame
	local at = pivot * vec(Specs.Spawn)
	return CFrame.lookAt(at, at + pivot.LookVector * -1) + Vector3.new(0, 3, 0)
end

local PLAIN: { [string]: boolean } = { Glass = true, FloorPaint = true }
local TINTED: { [string]: Color3 } = {
	Facade = Lobby.Paint.Walls,
	CounterFront = Lobby.Paint.Counter,
	Walls = Lobby.Paint.Sage,
	WallsUpper = Lobby.Paint.Cream,
	Ceiling = Lobby.Paint.Ceiling,
	UnitWallsLeft = Lobby.Paint.UnitWalls,
	UnitWallsRight = Lobby.Paint.UnitWalls,
	UnitTops = Lobby.Paint.UnitTops,
}

-- Makes an inserted model the template, once, in Edit (the command bar or Studio's MCP;
-- art/lobby/README.md, "Into Studio"): its parts squared on the frame from Specs, anchored and out
-- of physics, the plain parts coloured, the colliders built from Specs, streamed whole.
function Lobby.prepare(model: Model): Model
	local floor = part(model, "Floor")
	local floorSpec = Specs.Parts.Floor
	-- every part keeps the FBX's axes, so the floor's turn is the lobby's; its middle is known
	local frame = floor.CFrame * CFrame.new(-vec(floorSpec.Centre))
	for _, d in model:GetDescendants() do
		if d:IsA("PackageLink") then
			d:Destroy()
		end
	end
	for _, tag in model:GetTags() do
		if tag:sub(1, 10) == "Assistant:" then
			model:RemoveTag(tag) -- the MCP's insert marks what it adds
		end
	end
	model.WorldPivot = frame
	for name, spec in Specs.Parts do
		local p = part(model, name) :: MeshPart
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		p.CollisionFidelity = Enum.CollisionFidelity.Box
		p.PivotOffset = CFrame.new(-vec(spec.Centre)) -- its pivot on the lobby's frame
		p.CFrame = frame * CFrame.new(vec(spec.Centre))
		if PLAIN[name] then
			for _, s in p:GetChildren() do
				if s:IsA("SurfaceAppearance") then
					s:Destroy()
				end
			end
		end
		local tint = TINTED[name]
		if tint then
			p.Color = tint
			local look = p:FindFirstChildOfClass("SurfaceAppearance")
			if look then
				look.AlphaMode = Enum.AlphaMode.Overlay -- the paint shows where the map is clear
			end
		end
	end
	local glass = part(model, "Glass")
	-- plain, not Glass: Glass seen from the lit room showed only black (Studio, A16), this shows
	-- the night sky and the porch light's pool on the concrete outside
	glass.Material = Enum.Material.SmoothPlastic
	glass.Color = Lobby.Paint.Glass
	glass.Transparency = 0.82
	glass.CastShadow = false
	local paint = part(model, "FloorPaint")
	paint.Material = Enum.Material.SmoothPlastic
	paint.Color = Lobby.Paint.Stripes
	paint.Transparency = 0.12 -- worn: the concrete's tone comes through
	paint.CastShadow = false
	-- the 28 round lamps glow (Neon) but throw no light of their own: the fills light the room
	local lamps = part(model, "Lamps")
	lamps.Material = Enum.Material.Neon
	lamps.Color = Lobby.Paint.Lamps
	part(model, "Runner").Material = Enum.Material.Fabric -- the runner rug reads soft underfoot
	for _, name in
		{
			"Floor",
			"Boards",
			"Runner",
			"Ceiling",
			"Deck",
			"Joists",
			"Lamps",
			"Panel",
			"WallsUpper",
			"UnitTops",
		}
	do
		-- the floors and the rug have nothing under them to shade; the ceilings, the deck, the
		-- joists, the lamps, the upper walls and the units' ceilings nothing over them (every light
		-- is under them). The units' walls do cast:
		-- they keep each unit's bulb out of the next unit.
		part(model, name).CastShadow = false
	end
	part(model, "Signs").Color = Lobby.Paint.Plate

	local old = model:FindFirstChild("Colliders")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Colliders"
	for _, c in Specs.Colliders do
		local p = Instance.new("Part")
		p.Name = c.Name
		p.Anchored = true
		p.CanCollide = true
		p.CanTouch = false
		p.Transparency = 1
		p.CastShadow = false
		-- footsteps and anything that reads the ground hear concrete; the rest is steel
		p.Material = if c.Name == "Floor" then Enum.Material.Concrete else Enum.Material.Metal
		p.Size = vec(c.Size)
		p.CFrame = frame * CFrame.new(vec(c.Centre))
		p.Parent = folder
	end
	folder.Parent = model
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model:SetAttribute("Lobby", true)
	return model
end

-- A card (Specs.Cards) with `text` written on it: an invisible face the size of the sign, its
-- front looking where the sign does.
local function card(pivot: CFrame, spec: Specs.Card, text: string, parent: Instance): Part
	local centre = pivot * vec(spec.Centre)
	local facing = pivot:VectorToWorldSpace(vec(spec.Facing))
	local p = Instance.new("Part")
	p.Name = `Card{spec.Name}`
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Transparency = 1
	p.Size = Vector3.new(spec.Size[1], spec.Size[2], 0.02)
	p.CFrame = CFrame.lookAt(centre, centre + facing)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = Lobby.InkLight
	gui.MaxDistance = 200
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
	label.Text = text
	label.TextColor3 = Lobby.Ink
	label.TextScaled = true
	label.Parent = gui
	gui.Parent = p
	p.Parent = parent
	return p
end

-- The climb's M unit, in the place at ReplicatedStorage.Units.M (FloorBuilder.units), if it's there.
local function unitTemplate(): Model?
	local units = ReplicatedStorage:FindFirstChild("Units")
	local found = if units then units:FindFirstChild("M") else nil
	return if found and found:IsA("Model") then found else nil
end

-- Slot `slot`'s front (Specs.Slots): a copy of the climb's M unit with Lobby.Dropped left out, its
-- doorway's outer face on the slot's Door looking Out onto the floor, as FloorBuilder.unit stands a
-- climb's unit at a door face, then dressed as a home (Home.dress: the home's facade, casing,
-- switch and lamp, the door in HomeDoor) with its starter set inside. Its door is shut, unlocked
-- and tagged, so the Doors system gives it the climb's buttons and it rolls and slams the same; no
-- floor deals it, so it's empty (a3 makes it a player's). With no home template in the place it
-- stands as the climb's M, its bulb on its door as on a climb.
function Lobby.front(template: Model, home: Model?, pivot: CFrame, slot: Specs.Slot): Model
	local unit = template:Clone()
	for _, name in Lobby.Dropped do
		StorageUnit.UnitKit.dropWall(unit, name)
	end
	local spec = StorageUnit.RollUpDoor.spec(unit)
	local outer = StorageUnit.RollUpDoor.frame(unit) * CFrame.new(0, 0, -spec.CurtainPlane)
	local face = Arranged.face(pivot, slot.Door, slot.Out) -- the starter set's frame
	unit:PivotTo(face * outer:ToObjectSpace(unit:GetPivot()))
	unit.Name = `Unit{slot.Number}`
	if home then
		Home.dress(home, unit, face)
		part(unit, "Lamp"):SetAttribute(UnitLight.HomeAttribute, true)
		local starter = Instance.new("Folder")
		starter.Name = "Starter"
		for _, s in Home.Specs.Starter do
			if Home.has(home, s.Kind) then
				Home.piece(home, s.Kind, Arranged.piece(face, s.At, s.Turn), starter)
			end
		end
		starter.Parent = unit
		Home.mirror(home, unit, face)
	else
		StorageUnit.UnitKit.paint(unit, Lobby.UnitDoor, Lobby.Paint.Walls)
		StorageUnit.UnitKit.number(unit, tostring(slot.Number))
		if CorridorKit.template("Bulb") then
			-- the climb's bulb, wired to the door the same, hung as a home's (UnitLight.Home)
			local bulb = CorridorKit.hangBulb(CFrame.new(pivot * vec(slot.Bulb)), unit)
			bulb.glass:SetAttribute(UnitLight.HomeAttribute, true)
		end
	end
	StorageUnit.RollUpDoor.fitCollider(unit)
	unit:SetAttribute("LobbySlot", slot.Number)
	if home then
		-- a spare home until FrontOffice hands it out: held by nobody, shut and padlocked (D-275)
		unit:SetAttribute(StorageUnit.Door.HolderAttribute, 0)
		StorageUnit.RollUpDoor.setLocked(unit, true)
		-- its room is the slot's (Inside), not the M's 12 by 12: ShutIn counts you in to the back
		local into = -vec(slot.Out)
		local size = vec(slot.Inside.Size)
		local back = (vec(slot.Inside.Centre) - vec(slot.Door)):Dot(into)
			+ math.abs(size:Dot(into)) / 2
		local across = Vector3.new(into.Z, 0, -into.X) -- level, square to `into`
		unit:SetAttribute(StorageUnit.RollUpDoor.RoomDepth, back)
		unit:SetAttribute(StorageUnit.RollUpDoor.RoomWidth, math.abs(size:Dot(across)))
	end
	return unit
end

export type Laid = {
	folder: Folder,
	model: Model,
	pivot: CFrame,
	cars: { Model },
	-- each slot's front by its number (Specs.Slots), when the place has the M unit
	units: { [number]: Model },
	-- each slot's name card over its door, by its number (Specs.Slots' Card), blank until held
	cards: { [number]: TextLabel },
}

-- Lays a copy of the front office at `pivot` under a new folder in `parent`, with everything the
-- game adds to the art. Nil, with a warning, if the place has no template.
function Lobby.lay(pivot: CFrame, parent: Instance): Laid?
	local template = Lobby.template()
	if not template then
		warn("Lobby: no template at ReplicatedStorage.Props.Lobby (art/lobby/README.md)")
		return nil
	end
	local folder = Instance.new("Folder")
	folder.Name = "FrontOffice"
	local model = template:Clone()
	model:PivotTo(pivot)
	model.Parent = folder

	local dressing = Instance.new("Folder")
	dressing.Name = "Dressing"
	-- a home's card is blank until someone holds it (FrontOffice letters their name on)
	local slotOf: { [string]: number } = {}
	for _, slot in Specs.Slots do
		slotOf[slot.Card] = slot.Number
	end
	local cards: { [number]: TextLabel } = {}
	for _, c in Specs.Cards do
		local words = if c.Name:sub(1, 3) == "Bay" then c.Name:sub(4) else Lobby.Words[c.Name]
		local p = card(pivot, c, words or "", dressing)
		local number = slotOf[c.Name]
		if number then
			p:SetAttribute(Home.CardSlot, number)
			p:AddTag(Home.CardTag)
			cards[number] = p:FindFirstChildWhichIsA("TextLabel", true) :: TextLabel
		end
	end
	for _, s in Specs.Stock do
		local at = pivot * vec(s.At)
		-- each box's labelled side faces the room (the lobby's +X, from the left wall)
		local face = CFrame.lookAt(at, at + pivot.RightVector * -1)
		Boxes.clone(s.Kind :: Boxes.Name, face * CFrame.Angles(0, math.rad(s.Turn), 0), dressing)
	end
	-- the home starts on the units' first partition line: nearer the cars than that is their strip
	local landing = -math.huge
	for _, slot in Specs.Slots do
		landing = math.max(landing, slot.Inside.Centre[3] + slot.Inside.Size[3] / 2)
	end
	if CorridorKit.template("Fixture") then
		for _, l in Specs.Lights do
			if l[3] < landing then
				continue -- over the home: the round lamps in its ceiling light it
			end
			local fixture = CorridorKit.hang(pivot * CFrame.new(vec(l)), dressing)
			-- glowing, but throwing no light of its own (the fills do), its eye shut: no keeper here
			HallLight.glow(fixture.diffuser, 1, false)
			HallLight.eye(fixture.eye, "Blind")
		end
	end
	local f = Lobby.Fill
	for _, deep in f.Deep do
		for _, side in { -1, 1 } do
			local a = Instance.new("Part")
			a.Name = "Fill"
			a.Anchored = true
			a.CanCollide = false
			a.CanTouch = false
			a.CanQuery = false
			a.Transparency = 1
			a.Size = Vector3.one * 0.2
			a.CFrame = pivot * CFrame.new(side * f.Across, f.Height, -deep)
			local light = Instance.new("PointLight")
			light.Color = f.Colour
			light.Brightness = f.Brightness
			light.Range = f.Range
			light.Shadows = false
			light:SetAttribute(HallLight.LitAttribute, f.Brightness)
			light:AddTag(HallLight.Tag)
			light.Parent = a
			a.Parent = dressing
		end
	end
	local porch = Instance.new("Part")
	porch.Name = "Porch"
	porch.Anchored = true
	porch.CanCollide = false
	porch.CanTouch = false
	porch.CanQuery = false
	porch.CastShadow = false
	porch.Transparency = 1
	porch.Size = Vector3.one * 0.2
	local at = pivot * Lobby.Porch.At
	porch.CFrame = CFrame.lookAt(at, at + pivot:VectorToWorldSpace(Lobby.Porch.Aim))
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Front
	spot.Color = Lobby.Porch.Colour
	spot.Brightness = Lobby.Porch.Brightness
	spot.Range = Lobby.Porch.Range
	spot.Angle = Lobby.Porch.Angle
	spot.Shadows = true
	spot.Parent = porch
	porch.Parent = dressing
	-- a cart parked nose-in at every slot of the rack (Cart, L-08e4a)
	if Cart.template() then
		for i, s in Specs.CartSlots do
			local look = Lobby.Parked[(i - 1) % #Lobby.Parked + 1]
			local slot = pivot * CFrame.new(vec(s)) * CFrame.Angles(0, math.rad(look.Turn), 0)
			local cart = Cart.park(slot, look.Casters, dressing)
			if cart then
				cart.Name = `Cart{i}`
			end
		end
	else
		warn("Lobby: no cart template at ReplicatedStorage.Props.Cart, so the rack stands empty")
	end
	-- the plants by the doors, the benches between and the planters in the middle (D-266)
	local home = Home.template()
	if home then
		for _, d in Specs.Dressing do
			local place = pivot * CFrame.new(vec(d.At)) * CFrame.Angles(0, math.rad(d.Turn), 0)
			Home.piece(home, d.Kind, place, dressing)
		end
	else
		warn("Lobby: no home template at ReplicatedStorage.Props.Home (art/home/README.md)")
	end
	dressing.Parent = folder

	-- a home's front standing in each gap the side walls leave, its door shut (`front`)
	local units: { [number]: Model } = {}
	local front = unitTemplate()
	if front then
		local fronts = Instance.new("Folder")
		fronts.Name = "Units"
		for _, slot in Specs.Slots do
			local unit = Lobby.front(front, home, pivot, slot)
			unit.Parent = fronts
			units[slot.Number] = unit
		end
		fronts.Parent = folder
	else
		warn("Lobby: no unit template at ReplicatedStorage.Units.M, so the units' gaps stand open")
	end

	-- the climb's own car in each bay, its gate folded open and its lamp lit, marked a lobby car
	-- with its bay before it's tagged, so every screen knows its keypad sleeps (LobbyCars runs it)
	local cars = {}
	local car = Elevator.template()
	if car then
		for i in Specs.Bays do
			local m = car:Clone()
			m.Name = `Car{i}`
			m:PivotTo(Lobby.bay(pivot, i))
			Elevator.setGate(m, 0)
			Elevator.fitGate(m, 0)
			m:SetAttribute(Gate.Attribute, Gate.encode(0, 0, 0))
			m:SetAttribute(Boarding.CarAttribute, i)
			m:AddTag(Elevator.Tag)
			m.Parent = folder
			table.insert(cars, m)
		end
	else
		warn("Lobby: no elevator template, so the bays stand empty (art/elevator/README.md)")
	end
	folder.Parent = parent
	return {
		folder = folder,
		model = model,
		pivot = pivot,
		cars = cars,
		units = units,
		cards = cards,
	}
end

return Lobby
