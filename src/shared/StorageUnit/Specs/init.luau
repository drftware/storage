--!strict
-- Unit sizes by name. Each child module is generated by art/unit/build.py --stage export.
local M = require(script.M)

export type Spec = typeof(M)

local Specs: { [string]: Spec } = { M = M }
for _, child in script:GetChildren() do
	if child:IsA("ModuleScript") and Specs[child.Name] == nil then
		Specs[child.Name] = (require :: any)(child)
	end
end

return Specs
