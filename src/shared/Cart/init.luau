--!strict
--[[
	Cart: the front office's platform cart (art/cart/README.md, L-08e4). An orange steel deck on
	four casters with a push handle at the back; the front pair of casters swivel. Today the carts
	stand parked in the rack by the front door; the ride (L-08e4b) moves them.

	The art is one imported model (art/cart/out/Cart.fbx): the body and six moving parts (two
	swivel forks, four wheels), kept in the place at ReplicatedStorage.Props.Cart (D-009) and made
	a template once in Edit by `Cart.prepare`. Its frame: the pivot on the floor under the deck's
	middle, the nose toward the LookVector, the handle behind (Specs, generated by
	art/cart/build.py).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Specs = require(script.Specs)

local Cart = {}
Cart.Specs = Specs
Cart.Body = "Cart" -- the body's MeshPart, the model's PrimaryPart

function Cart.template(): Model?
	local props = ReplicatedStorage:FindFirstChild("Props")
	local found = if props then props:FindFirstChild("Cart") else nil
	return if found and found:IsA("Model") then found else nil
end

local function part(model: Instance, name: string): BasePart
	local found = model:FindFirstChild(name)
	assert(found and found:IsA("BasePart"), `Cart: {model:GetFullName()} has no {name}`)
	return found
end

-- Makes an inserted model the template, once, in Edit (Studio's MCP; art/cart/README.md, "Into
-- Studio"): squared on its own frame at the origin, every part anchored and out of physics but
-- the deck's collider, the body its PrimaryPart, streamed whole.
function Cart.prepare(model: Model): Model
	for _, d in model:GetDescendants() do
		if d:IsA("PackageLink") then
			d:Destroy()
		end
	end
	local body = part(model, Cart.Body)
	-- every part keeps the FBX's axes, so the body's turn is the cart's; its middle is known
	local frame = body.CFrame * CFrame.new(-Specs.Parts.Cart.Centre)
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") then
			p.CFrame = frame:ToObjectSpace(p.CFrame)
			p.PivotOffset = CFrame.identity
			p.Anchored = true
			p.CanCollide = false
			p.CanTouch = false
			p.CanQuery = p == body
			-- the small parts' shadows are lost under the deck's
			p.CastShadow = p == body
		end
	end
	-- what you bump and step onto: the deck, a box from the floor to the mat's top
	local old = model:FindFirstChild("Deck")
	if old then
		old:Destroy()
	end
	local deck = Instance.new("Part")
	deck.Name = "Deck"
	deck.Anchored = true
	deck.CanTouch = false
	deck.Transparency = 1
	deck.CastShadow = false
	deck.Size = Specs.Deck
	deck.CFrame = CFrame.new(0, Specs.Deck.Y / 2, 0)
	deck.Parent = model
	-- the model's pivot is its PrimaryPart's: put it on the floor under the deck's middle (with a
	-- PrimaryPart set, a write to WorldPivot doesn't take; the carts parked a stud and a half sunk)
	model.PrimaryPart = body
	body.PivotOffset = CFrame.new(-Specs.Parts.Cart.Centre)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model.Name = "Cart"
	return model
end

-- A copy of the template parked at `at` (its pivot on the floor, its nose toward at's
-- LookVector) under `parent`, each front caster turned `swivel[i]` degrees about its kingpin as a
-- cart left standing has them. Nil if the place has no template.
function Cart.park(at: CFrame, swivel: { number }, parent: Instance): Model?
	local template = Cart.template()
	if not template then
		return nil
	end
	local model = template:Clone()
	local k = 0
	for _, c in Specs.Casters do
		local forkName = c.Fork
		if forkName then
			k += 1
			local pin = CFrame.new(c.Kingpin)
			local turn = pin * CFrame.Angles(0, math.rad(swivel[k] or 0), 0) * pin:Inverse()
			local fork = part(model, forkName)
			local wheel = part(model, c.Wheel)
			fork.CFrame = turn * fork.CFrame
			wheel.CFrame = turn * wheel.CFrame
		end
	end
	model:PivotTo(at)
	model.Parent = parent
	return model
end

return Cart
